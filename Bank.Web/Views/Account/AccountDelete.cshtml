@model AccountsDto

@{
    ViewData["Title"] = "Delete Account";
}
<form asp-action="AccountDelete">
    <h2 class="text-center">Delete Account</h2>
    <input asp-for="Id" hidden />

    <div class="row justify-content-center">
        <div class="col-md-6">
            <span asp-action="AccountDelete">
                <div class="form-group mb-3">
                    <label asp-for="Number" class="form-label"></label>
                    <input asp-for="Number" disabled  class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Balance" class="form-label"></label>
                    <input asp-for="Balance" disabled class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="OwnerId" class="form-label"></label>
                    <input asp-for="OwnerId" disabled class="form-control" />
                </div>

        </div>
        <div class="form-group text-end">
            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="AccountIndex" class="btn btn-secondary">Back to List</a>

        </div>
    </div>
</form>


