@model IEnumerable<AccountsDto>

@{
    ViewData["Title"] = "Accounts List";
}

<h2 class="text-center">Accounts List</h2>

<div class="text-end mb-3">
    <a asp-action="AccountCreate" class="btn btn-primary">+ Create New Account</a>
</div>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Number</th>
            <th>Balance</th>
            <th>OwnerId</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Number</td>
                <td>@item.Balance</td>
                <td>@item.OwnerId</td>
                <td>
                    <a asp-action="AccountDelete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
